---
import Layout from "@/layouts/BaseLayout.astro";
import InsightArticle from "@/components/content/InsightArticle.astro";
import { getInsights, type Insight } from "@/utils/insights";

export async function getStaticPaths() {
  const articles = await getInsights();
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}
interface Props { article: Insight }
const { article } = Astro.props;
---
<Layout title={article.title} description={article.description ?? undefined} theme="light">
  <InsightArticle article={article} />
</Layout>

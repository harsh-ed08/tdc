---
import Grid from "@/components/wrapper/Grid.astro";
import { Image } from "astro:assets";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import missionArt from "@/assets/images/mission-art.jpg";
import visionArt from "@/assets/images/vision-art.jpg";

const leaders = [
  { name: "Rahul Meghani", role: "Director and Chief Advisor", image: missionArt, linkedin: "" },
  { name: "Arun Chauhan", role: "Chief Legal Advisor", image: visionArt, linkedin: "" },
];
---

<section id="leadership" tabindex="-1" class="leadership_wrap theme-light" aria-labelledby="leadership-title">
  <div class="leadership_inner layout_frame layout_columns">
    <div class="leadership_rules layout_rules" aria-hidden="true"><span /><span /></div>
    <Eyebrow variant="section" tag="h2" id="leadership-title" class="leadership_label">Leadership</Eyebrow>
    <Grid medium={2} class="leadership_cards">
      {leaders.map((leader) => (
        <article class="leadership_card">
          <Image class="leadership_image display-block width-full height-auto ratio-1-1 object-fit-cover" src={leader.image} alt="" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 1023px) 45vw, 35vw" />
          <div class="leadership_details flex-horizontal-nowrap justify-content-between gap-3">
            <div>
              <Heading tag="h3" variant="h5" class="leadership_name">{leader.name}</Heading>
              <p class="leadership_role text-style-main">{leader.role}</p>
            </div>
            <a
              class="leadership_social flex-noshrink"
              href={leader.linkedin || "#"}
              target={leader.linkedin ? "_blank" : undefined}
              rel={leader.linkedin ? "noopener noreferrer" : undefined}
              aria-label={`${leader.name} on LinkedIn${leader.linkedin ? " (opens in a new tab)" : ""}`}
            >
              <svg class="leadership_social-icon" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M4.5 3.24268C3.67157 3.24268 3 3.91425 3 4.74268V19.7427C3 20.5711 3.67157 21.2427 4.5 21.2427H19.5C20.3284 21.2427 21 20.5711 21 19.7427V4.74268C21 3.91425 20.3284 3.24268 19.5 3.24268H4.5ZM8.52076 7.2454C8.52639 8.20165 7.81061 8.79087 6.96123 8.78665C6.16107 8.78243 5.46357 8.1454 5.46779 7.24681C5.47201 6.40165 6.13998 5.72243 7.00764 5.74212C7.88795 5.76181 8.52639 6.40728 8.52076 7.2454ZM12.2797 10.0044H9.75971H9.7583V18.5643H12.4217V18.3646C12.4217 17.9847 12.4214 17.6047 12.4211 17.2246C12.4203 16.2108 12.4194 15.1959 12.4246 14.1824C12.426 13.9363 12.4372 13.6804 12.5005 13.4455C12.7381 12.568 13.5271 12.0013 14.4074 12.1406C14.9727 12.2291 15.3467 12.5568 15.5042 13.0898C15.6013 13.423 15.6449 13.7816 15.6491 14.129C15.6605 15.1766 15.6589 16.2242 15.6573 17.2719C15.6567 17.6417 15.6561 18.0117 15.6561 18.3815V18.5629H18.328V18.3576C18.328 17.9056 18.3278 17.4537 18.3275 17.0018C18.327 15.8723 18.3264 14.7428 18.3294 13.6129C18.3308 13.1024 18.276 12.599 18.1508 12.1054C17.9638 11.3713 17.5771 10.7638 16.9485 10.3251C16.5027 10.0129 16.0133 9.81178 15.4663 9.78928C15.404 9.78669 15.3412 9.7833 15.2781 9.77989C14.9984 9.76477 14.7141 9.74941 14.4467 9.80334C13.6817 9.95662 13.0096 10.3068 12.5019 10.9241C12.4429 10.9949 12.3852 11.0668 12.2991 11.1741L12.2797 11.1984V10.0044ZM5.68164 18.5671H8.33242V10.01H5.68164V18.5671Z" fill-rule="evenodd" clip-rule="evenodd" fill="currentColor"/>
</svg>
            </a>
          </div>
        </article>
      ))}
    </Grid>
  </div>
</section>

<style is:global>
  @layer components {
    .leadership_wrap {
      background: var(--background);
      color: var(--text);
      .leadership_inner {

        padding-block: clamp(3rem, 5.56vw, 5rem) clamp(4rem, 6.67vw, 6rem);
      }
      .leadership_rules {
        --layout-rule-color: color-mix(in srgb, var(--dark-900) 15%, transparent);
      }
      .leadership_label {
        grid-column: 1;
        align-self: start;
        padding: 0.375rem 0.5rem;
      }
      .leadership_cards {
        grid-column: 2 / -1;
        --_gap-size: clamp(1.5rem, 3.89vw, 3.5rem);
      }
      .leadership_card { min-width: 0; }
      .leadership_details {
        padding: var(--space-3);
      }
      .leadership_name {
        margin: 0;
        font-size: clamp(1.25rem, 1.67vw, 1.5rem);
        font-weight: var(--primary-regular);
        line-height: 1.3;
        letter-spacing: var(--letter-spacing-normal);
        &::before, &::after { display: none; }
      }
      .leadership_role {
        margin: 0.5rem 0 0;
        font-size: clamp(1rem, 1.25vw, 1.125rem);
        font-weight: var(--primary-light);
        line-height: 1.4;
      }
      .leadership_social {
        display: grid;
        place-items: center;
        width: 2.75rem;
        height: 2.75rem;
        margin-right: -0.625rem;
        color: var(--neutral-500);
        transition: color var(--hover-duration) var(--hover-ease);
        &:hover, &:focus-visible { color: var(--brand-500); }
        &:focus-visible { outline: var(--focus-width) solid currentColor; outline-offset: var(--focus-offset); }
      }
      .leadership_social-icon {
        display: block;
        width: 2rem;
        height: 2rem;
      }
      @media (prefers-reduced-motion: reduce) {
        .leadership_social { transition: none; }
      }
      @media (width < 64rem) {
        .leadership_label { grid-column: 1 / -1; margin-bottom: var(--space-5); }
        .leadership_cards { grid-column: 1 / -1; }
      }
      @media (width < 48rem) {
        .leadership_cards { --_gap-size: var(--space-6); }
        .leadership_details { padding-inline: var(--space-2); }
      }
    }
  }
</style>

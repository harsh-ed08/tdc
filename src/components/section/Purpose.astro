---
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
---

<section class="purpose_wrap theme-light" aria-labelledby="purpose-title">
  <div class="purpose_inner">
    <div class="purpose_rules layout_rules" aria-hidden="true"><span /><span /></div>
    <Eyebrow tag="h2" id="purpose-title" class="purpose_label">Purpose</Eyebrow>
    <div class="purpose_copy">
      <Paragraph>
        We believe the mid-market deserves capital it can count on. Where businesses
        are assessed for what they're truly worth, capital is committed with clarity
        on value and time, and every decision is backed by the conviction to see it through.
      </Paragraph>
      <Paragraph>
        We are here to restore confidence among businesses and investors by bringing
        certainty to a market defined by the lack of it.
      </Paragraph>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let motion: ReturnType<typeof gsap.matchMedia> | undefined;

  function initPurposeMotion() {
    motion?.revert();
    motion = gsap.matchMedia();
    motion.add("(prefers-reduced-motion: no-preference)", () => {
      const originals: { paragraph: HTMLElement; html: string }[] = [];

      document.querySelectorAll<HTMLElement>(".purpose_copy").forEach((copy) => {
        const words: HTMLSpanElement[] = [];
        copy.querySelectorAll<HTMLElement>(".text").forEach((paragraph) => {
          originals.push({ paragraph, html: paragraph.innerHTML });
          const fragment = document.createDocumentFragment();
          // Keep spaces as text nodes so wrapping and reading order stay natural.
          for (const token of (paragraph.textContent ?? "").split(/(\s+)/)) {
            if (!token) continue;
            if (/^\s+$/.test(token)) {
              fragment.append(document.createTextNode(token));
            } else {
              const word = document.createElement("span");
              word.textContent = token;
              fragment.append(word);
              words.push(word);
            }
          }
          paragraph.replaceChildren(fragment);
        });

        gsap.fromTo(words, { opacity: 0.2 }, {
          opacity: 1,
          ease: "none",
          duration: 1,
          stagger: 0.15,
          scrollTrigger: {
            trigger: copy,
            start: "top 85%",
            end: "bottom 55%",
            scrub: 0.5,
          },
        });
      });

      return () => {
        originals.forEach(({ paragraph, html }) => { paragraph.innerHTML = html; });
      };
    });
  }

  initPurposeMotion();
  document.addEventListener("astro:page-load", initPurposeMotion);
  document.addEventListener("astro:before-swap", () => motion?.revert());
  document.fonts.ready.then(() => ScrollTrigger.refresh());
</script>

<style is:global>
  @layer components {
    .purpose_wrap {
      background: var(--background);
      color: var(--text);
      border-block: 0.03125rem solid var(--border);
      .purpose_inner {
        position: relative;
        display: grid;
        grid-template-columns: var(--layout-columns);
        width: calc(100% - 2 * var(--layout-gutter));
        max-width: var(--layout-max-width);
        margin-inline: auto;
        padding-block: clamp(3.75rem, 5.77vw, 5.2rem);
      }
      .purpose_rules {
        --layout-rule-color: color-mix(in srgb, var(--dark-900) 15%, transparent);
      }
      .purpose_label {
        grid-column: 1;
        align-self: start;
        gap: 0.4rem;
        padding-inline: 0.375rem;
        .eyebrow_marker {
          width: 0.5rem;
          height: 0.75rem;
          background: url("/purpose-icon.svg") center / contain no-repeat;
        }
        .eyebrow_text {
          margin: 0;
          font-family: var(--label-family);
          font-size: clamp(0.6875rem, 1.06vw, 0.9375rem);
          font-weight: var(--primary-medium);
          line-height: 1.4;
          text-transform: uppercase;
          &::before, &::after { display: none; }
        }
      }
      .purpose_copy {
        grid-column: 2 / -1;
        min-width: 0;
        max-width: 41rem;
        width: 65%;
        padding-inline: clamp(1rem, 2.22vw, 2rem);
        padding-top: clamp(3rem, 7.5vw, 6.75rem);
        font-family: var(--primary-family);
        font-size: clamp(1.125rem, 1.73vw, 1.5rem);
        font-weight: var(--primary-regular);
        line-height: 1.3;
        .text {
          margin: 0;
          text-wrap: initial;
          &::before, &::after { display: none; }
          + .text { margin-top: 1.3em; }
        }
      }
      @media (width < 64rem) {
        .purpose_copy { width: 100%; }
      }
      @media (width < 48rem) {
        .purpose_inner { padding-block: 2.5rem 3rem; }
        .purpose_label { padding-inline: 0.75rem; }
        .purpose_copy {
          grid-column: 1 / -1;
          padding-inline: 0.75rem;
          padding-top: 3rem;
        }
      }
    }
  }
</style>

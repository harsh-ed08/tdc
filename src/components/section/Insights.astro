---
import Grid from "@/components/wrapper/Grid.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import CtaArrow from "@/components/typography/CtaArrow.astro";
import RollLabel from "@/components/typography/RollLabel.astro";
import { getInsights, insightDate, type Insight } from "@/utils/insights";
import { selectInsights } from "@/utils/insight-filter.mjs";

let articles: Insight[] = [];
let failed = false;
try { articles = await getInsights(); }
catch (error) { failed = true; console.error("Could not load insights:", error); }
const businesses = [...new Set(["Private Credit", "Investment Banking", "Special Situation", ...articles.map((article) => article.business).filter(Boolean)])];
const postTypes = [...new Set(articles.map((article) => article.postType).filter(Boolean))].sort();
const initial = selectInsights(articles);
---

<section class="insights_wrap" aria-labelledby="insights-title" data-insights>
  <div class="insights_frame layout_frame layout_columns">
    <div class="layout_rules" aria-hidden="true"><span /><span /></div>
    <header class="insights_intro">
      <Heading tag="h1" variant="h1" id="insights-title" class="margin-top-0 margin-bottom-4 text-wrap-default">We break down the<br class="insights_desktop-break" /> smallest details so you can<br class="insights_desktop-break" /> see the destination.</Heading>
      <Paragraph variant="main" class="insights_description line-height-large margin-block-0">Expert perspectives, trends and industry-specific point of view on India's mid-market financing.</Paragraph>
    </header>
    <aside class="insights_sidebar" aria-label="Filter insights">
      <form class="insights_filters padding-bottom-6" role="search">
        <p class="text-style-label margin-top-0 margin-bottom-3">Filters</p>
        <label class="insights_search flex-horizontal-nowrap gap-2">
          <span class="sr-only">Search insights</span>
          <input class="text-style-label text-transform-none line-height-huge" type="search" name="search" placeholder="Search" autocomplete="off" data-search />
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="6" stroke="currentColor" stroke-width="1.5"/><path d="m15 15 6 6" stroke="currentColor" stroke-width="1.5"/></svg>
        </label>
        <details class="insights_categories margin-top-4 overflow-clip" open>
          <summary><Paragraph tag="span" variant="main" class="margin-block-0">By type</Paragraph><span aria-hidden="true"></span></summary>
          <fieldset>
            <legend class="sr-only">Types</legend>
            {postTypes.map((postType) => <label><input type="checkbox" name="postType" value={postType} /><Paragraph tag="span" variant="small" class="margin-block-0">{postType}</Paragraph></label>)}
          </fieldset>
        </details>
        <details class="insights_categories margin-top-4 overflow-clip">
          <summary><Paragraph tag="span" variant="main" class="margin-block-0">By business</Paragraph><span aria-hidden="true"></span></summary>
          <fieldset>
            <legend class="sr-only">Businesses</legend>
            {businesses.map((business) => <label><input type="checkbox" name="business" value={business} /><Paragraph tag="span" variant="small" class="margin-block-0">{business}</Paragraph></label>)}
          </fieldset>
        </details>
        <button type="reset" class="insights_reset margin-top-3" hidden><Paragraph tag="span" variant="small" class="margin-block-0">Clear filters</Paragraph></button>
      </form>
    </aside>
    <div class="insights_results">
      {failed && <Paragraph variant="main" role="alert">We couldn't load our insights. Please refresh the page to try again.</Paragraph>}
      <Grid medium={2} class="insights_list" id="insights-grid">
        {articles.map((article) => (
          <article class:list={["insights_card", initial.spotlight?._id === article._id && "is-spotlight"]}
            data-card data-id={article._id} data-category={article.category} data-type={article.postType} data-business={article.business} data-title={article.title}
            data-description={article.description ?? ""} data-spotlight={article.spotlight}
            hidden={article !== initial.spotlight && !initial.cards.includes(article)}>
            <a class="insights_card-link flex-vertical-nowrap align-items-stretch justify-content-start height-full color-inherit" href={`/insights/${encodeURIComponent(article.slug)}/`}>
              <div class="insights_visual position-relative width-full flex-noshrink overflow-hidden">
                {article === initial.spotlight ? <img src="/spotlight-post-image.avif" alt="" width="1200" height="800" loading="eager" /> : article.image ? <img src={`${article.image}?auto=format&w=1200&q=85`} alt={article.imageAlt ?? ""} width="1200" height="800" loading="lazy" /> : <div class="insights_placeholder" aria-hidden="true" />}
                <p class="insights_meta text-style-small text-transform-uppercase line-height-large margin-block-0"><span>{article.postType}</span>{article.publishedAt && <time datetime={article.publishedAt}>{insightDate(article.publishedAt)}</time>}{article.business && <span class="insights_business">{article.business}</span>}</p>
              </div>
              <div class="insights_card-copy flex-grow padding-4">
                <Heading tag="h2" variant="h5" class="insights_card-title margin-top-0 margin-bottom-2">{article.title}</Heading>
                {article.description && <Paragraph variant="small" class="line-height-large margin-block-0">{article.description}</Paragraph>}
              </div>
            </a>
          </article>
        ))}
      </Grid>
      <Paragraph variant="main" data-empty hidden={failed || initial.total > 0}>No insights found. Try a different filter or search.</Paragraph>
      <div class="insights_bottom flex-horizontal-wrap justify-content-between gap-3 margin-top-4 padding-inline-3">
        <button class="insights_more flex-horizontal-nowrap gap-1 text-style-label" type="button" data-more aria-controls="insights-grid" hidden={!initial.hasMore}><RollLabel>SEE MORE</RollLabel><CtaArrow /></button>
        <p class="text-style-small margin-block-0 sr-only" data-count aria-live="polite" aria-atomic="true">{initial.total > 0 ? `Showing ${Math.min(initial.total, 6)} of ${initial.total} insights` : ""}</p>
      </div>
      <noscript><Paragraph variant="main">Enable JavaScript to use filters and load more insights.</Paragraph></noscript>
    </div>
  </div>
</section>

<script>
  import { selectInsights } from "@/utils/insight-filter.mjs";
  document.querySelectorAll<HTMLElement>("[data-insights]").forEach((root) => {
    const form = root.querySelector<HTMLFormElement>("form")!;
    const search = root.querySelector<HTMLInputElement>("[data-search]")!;
    const businesses = [...root.querySelectorAll<HTMLInputElement>('[name="business"]')];
    const postTypes = [...root.querySelectorAll<HTMLInputElement>('[name="postType"]')];
    const more = root.querySelector<HTMLButtonElement>("[data-more]")!;
    const reset = root.querySelector<HTMLButtonElement>('[type="reset"]')!;
    const accordions = [...root.querySelectorAll<HTMLDetailsElement>(".insights_categories")];
    const animations = new Map<HTMLDetailsElement, Animation>();
    let activeAccordion = accordions.find((details) => details.open);
    function slide(details: HTMLDetailsElement, opening: boolean) {
      const start = details.getBoundingClientRect().height;
      animations.get(details)?.cancel();
      details.open = true;
      const summary = details.querySelector<HTMLElement>("summary")!;
      const end = opening ? details.getBoundingClientRect().height : summary.getBoundingClientRect().height;
      details.querySelector<HTMLFieldSetElement>("fieldset")!.inert = !opening;
      summary.setAttribute("aria-expanded", String(opening));
      const duration = window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : parseFloat(getComputedStyle(root).getPropertyValue("--motion-close-duration"));
      const animation = details.animate([{ height: `${start}px` }, { height: `${end}px` }], { duration, easing: "ease-in-out" });
      animations.set(details, animation);
      animation.onfinish = () => {
        details.open = opening;
        animations.delete(details);
      };
    }
    accordions.forEach((details) => {
      const summary = details.querySelector<HTMLElement>("summary")!;
      summary.setAttribute("aria-expanded", String(details.open));
      summary.addEventListener("click", (event) => {
        event.preventDefault();
        const opening = activeAccordion !== details;
        if (activeAccordion && activeAccordion !== details) slide(activeAccordion, false);
        activeAccordion = opening ? details : undefined;
        slide(details, opening);
      });
    });
    const cards = [...root.querySelectorAll<HTMLElement>("[data-card]")].map((element) => ({
      element, category: element.dataset.category!, postType: element.dataset.type!, business: element.dataset.business!, title: element.dataset.title!,
      description: element.dataset.description, spotlight: element.dataset.spotlight === "true",
    }));
    let limit = 6;
    function update() {
      const selectedBusinesses = businesses.filter((input) => input.checked).map((input) => input.value);
      const selectedTypes = postTypes.filter((input) => input.checked).map((input) => input.value);
      const result = selectInsights(cards, selectedTypes, search.value, limit, selectedBusinesses);
      cards.forEach((card) => {
        card.element.hidden = card !== result.spotlight && !result.cards.includes(card);
        card.element.classList.toggle("is-spotlight", card === result.spotlight);
      });
      more.hidden = !result.hasMore;
      reset.hidden = !selectedBusinesses.length && !selectedTypes.length && !search.value;
      root.querySelector<HTMLElement>("[data-empty]")!.hidden = result.total > 0 || cards.length === 0;
      root.querySelector<HTMLElement>("[data-count]")!.textContent = cards.length ? `Showing ${result.cards.length} of ${result.total} insights` : "";
    }
    form.addEventListener("submit", (event) => event.preventDefault());
    form.addEventListener("change", () => {
      limit = 6; update();
    });
    search.addEventListener("input", () => { limit = 6; update(); });
    form.addEventListener("reset", () => { requestAnimationFrame(() => { limit = 6; update(); }); });
    more.addEventListener("click", () => {
      const previouslyHidden = cards.filter((card) => card.element.hidden);
      limit += 6; update();
      previouslyHidden.find((card) => !card.element.hidden)?.element.querySelector("a")?.focus({ preventScroll: true });
    });
  });
</script>

<style is:global>
@layer components {
  .insights_wrap {
    background: var(--light-300); color: var(--dark-900);
    .insights_intro { grid-column: 2 / -1; padding: clamp(3rem, 5.6vw, 5rem) var(--space-3) clamp(3rem, 5.6vw, 5rem); }
    .insights_description { max-width: 34rem; }
    .insights_sidebar { padding-inline: var(--space-2); }
    .insights_filters { position: sticky; top: calc(var(--nav-height) + var(--space-5)); max-height: calc(100dvh - var(--nav-height) - var(--space-6)); overflow-y: auto; }
    .insights_search { min-height: 3rem; border: var(--border-thin) solid currentColor; padding: 0 var(--space-2); }
    .insights_search input { width: 100%; min-width: 0; color: inherit; border: 0; background: transparent; padding: 0; }
    .insights_search input::placeholder { color: inherit; opacity: .8; }
    .insights_search input:focus { outline: none; }
    .insights_search:focus-within { border-color: var(--brand-500); }
    .insights_search svg { flex: none; box-sizing: content-box; width: 1.5rem; height: 1.75rem; padding-left: .375rem; border-left: var(--border-thin) solid currentColor; }
    .insights_categories summary { cursor: pointer; color: inherit; display: flex; gap: var(--space-2); align-items: center; list-style: none; padding-block: .25rem; }
    .insights_categories[open] summary { color: var(--brand-500); } .insights_categories summary::-webkit-details-marker { display: none; }
    .insights_categories summary span[aria-hidden] { width: .5rem; height: .5rem; border-top: var(--border-thin) solid currentColor; border-right: var(--border-thin) solid currentColor; transform: translateY(.125rem) rotate(-45deg); }
    .insights_categories:not([open]) summary span[aria-hidden] { transform: translateY(-.125rem) rotate(135deg); }
    .insights_categories fieldset { border: 0; margin: var(--space-3) 0 0; padding: var(--space-3); display: grid; gap: .5rem; background: #d5d5d5; min-width: 0; }
    .insights_categories label { display: flex; align-items: center; gap: .5rem; cursor: pointer; overflow-wrap: anywhere; }
    .insights_categories input { appearance: none; width: 1rem; height: 1rem; margin: 0; border: 2px solid var(--dark-800); border-radius: .125rem; flex: none; display: grid; place-content: center; }
    .insights_categories input:checked { background: transparent; border-color: var(--brand-500); }
    .insights_categories input:checked::after { content: ""; width: .5rem; height: .25rem; border-left: 2px solid var(--brand-500); border-bottom: 2px solid var(--brand-500); transform: translateY(-.0625rem) rotate(-45deg); }
    .insights_categories label:has(input:checked) { color: var(--brand-500); }
    .insights_reset { text-decoration: underline; cursor: pointer; }
    .insights_results { grid-column: 2 / -1; min-width: 0; padding: 0 0 var(--space-8) var(--space-3); }
    .insights_list { --_gap-size: var(--space-4); }
    .insights_card { min-width: 0; border-bottom: var(--border-hairline) solid color-mix(in srgb, var(--dark-900) 20%, transparent); }
    .insights_card-link { text-decoration: none; }
    .insights_visual { aspect-ratio: 1.68; background: var(--dark-900); }
    .insights_visual img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--hover-duration) var(--hover-ease); }
    .insights_card-link:hover img { transform: scale(1.025); }
    .insights_placeholder { height: 100%; background: linear-gradient(135deg, var(--dark-900), var(--brand-500)); }
    .insights_meta { position: absolute; top: var(--space-4); left: var(--space-4); right: var(--space-4); display: flex; flex-wrap: wrap; width: fit-content; max-width: calc(100% - var(--space-4) * 2); overflow-wrap: anywhere; background: var(--light-300); color: var(--dark-900); padding: .25rem .4rem; gap: .35rem; }
    .insights_meta::before, .insights_meta::after { content: none; display: none; }
    .insights_meta > * { min-width: 0; }
    .insights_meta > * + * { border-left: var(--border-thin) solid currentColor; padding-left: .35rem; }
    .insights_business { color: var(--neutral-500); }

    .insights_card-copy { min-width: 0; overflow-wrap: anywhere; transition: background-color var(--hover-duration) var(--hover-ease); }
    .insights_card[data-business="Private Credit" i] { --insight-hover-background: var(--business-private-credit); }
    .insights_card[data-business="Investment Banking" i] { --insight-hover-background: var(--business-investment-banking); }
    .insights_card:is([data-business="Special Situation" i], [data-business="Special Situations" i]) { --insight-hover-background: var(--business-special-situations); }
    .insights_card:not(.is-spotlight) .insights_card-link:is(:hover, :focus-visible) .insights_card-copy { background-color: var(--insight-hover-background, var(--light-300)); }
    .insights_card:not(.is-spotlight) .insights_card-link:is(:hover, :focus-visible) .insights_card-title { color: var(--brand-500); }
    .insights_card.is-spotlight { grid-column: 1 / -1; grid-row: 1; border: 0; position: relative; }
    .is-spotlight .insights_visual { aspect-ratio: 2.94; min-height: 17rem; }
    .is-spotlight .insights_visual::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(20 8 0 / .8), transparent), linear-gradient(0deg, rgb(20 8 0 / .55), transparent 80%); }
    .is-spotlight .insights_meta { z-index: 1; }

    .is-spotlight .insights_card-copy { position: absolute; bottom: 0; left: 0; color: var(--light-300); width: min(65%, 36rem); }
    .insights_more { width: fit-content; cursor: pointer; min-height: 2.75rem; }
    .insights_more:focus-visible { outline: var(--focus-width) solid currentColor; outline-offset: var(--focus-offset); }
    [hidden] { display: none !important; }
    @media (width < 75rem) { .insights_desktop-break { display: none; } }
    @media (48rem <= width < 64rem) { .is-spotlight .insights_card-copy { width: 100%; } }
    @media (width < 48rem) {
      .insights_meta {
        top: var(--space-2);
        left: var(--space-2);
        right: auto;
        display: flex;
        flex-wrap: wrap;
        max-width: calc(100% - var(--space-2) * 2);
        padding: .5rem .625rem;
        gap: .25rem .375rem;
      }
      .insights_meta > :not(.insights_business) { white-space: nowrap; }
      .insights_meta > * + * { border-left: 0; padding-left: 0; }
      .insights_meta .insights_business { overflow-wrap: anywhere; }
      .insights_frame { display: block; }
      .insights_intro { padding: var(--space-7) var(--space-3); border: 0; }
      .insights_sidebar { padding: 0 var(--space-3); }
      .insights_filters { position: static; max-height: none; overflow: visible; }
      .insights_categories fieldset { grid-template-columns: 1fr; }
      .insights_results { padding: 0 var(--space-3) var(--space-7); border: 0; }
      .is-spotlight .insights_visual { aspect-ratio: 1.15; min-height: 20rem; }
      .is-spotlight .insights_card-copy { width: 100%; }
    }
    @media (prefers-reduced-motion: reduce) { .insights_visual img { transition: none; } .insights_card-link:hover img { transform: none; } }
  }
}

</style>

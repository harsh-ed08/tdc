---
import Heading from "@/components/typography/Heading.astro";
import RollLabel from "@/components/typography/RollLabel.astro";
import CtaArrow from "@/components/typography/CtaArrow.astro";
interface Props {
  variant?: "wide" | "compact" | "mobile";
}
const { variant = "compact" } = Astro.props;
---

<aside class:list={["nav-promo_wrap", variant]}>
  <img
    class="nav-promo_image"
    src={variant === "compact"
      ? "/navigation/fund-compact.png"
      : variant === "mobile"
        ? "/navigation/fund-mobile.png"
        : "/navigation/fund-wide.png"}
    alt="Red-brick real estate development"
    width="394"
    height="272"
  />
  <p class="nav-promo_label">
    {variant === "mobile" ? "NEW FUND ALERT" : "INSIGHTS"}
  </p>
  <Heading tag="h3" variant="inherit" class="nav-promo_title">
    ₹1,500 Cr Special Situations &amp; last-mile real estate debt fund activated
  </Heading>
  <a class="nav-promo_action" href="#"
    ><RollLabel>KNOW MORE</RollLabel><CtaArrow /></a
  >
</aside>
<style is:global>
  @layer components {
    .nav-promo_wrap {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr);
      grid-template-rows: auto 1fr auto;
      column-gap: 1rem;
      row-gap: 1rem;
      .nav-promo_image {
        grid-row: 1 / 4;
        width: 100%;
        height: 14.5rem;
        object-fit: cover;
      }
      .nav-promo_label,
      .nav-promo_action {
        font: 400 1rem/1.3 var(--label-family);
      }
      .nav-promo_label,
      .nav-promo_title {
        margin-block: 0;
      }
      .nav-promo_title {
        font: 300 1rem/1.3 var(--heading-family);
        text-wrap: initial;
      }
      .nav-promo_action {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        width: fit-content;
        align-self: start;
        max-width: 100%;
        transition: color var(--hover-duration) var(--hover-ease);
      }
      .nav-promo_action:is(:hover, :focus-visible) {
        color: var(--brand-500);
      }
      .nav-promo_action img {
        width: 1rem;
        height: 1.5158125rem;
      }
      &.wide {
        grid-template-columns: minmax(0, 3fr) minmax(0, 5fr);
        grid-template-rows: 1fr auto auto;
        column-gap: 0;
        row-gap: 1.5rem;
        .nav-promo_label,
        .nav-promo_title,
        .nav-promo_action {
          margin-left: 1.5rem;
        }
        .nav-promo_label {
          margin-top: 1.5rem;
          font: 400 0.875rem/1.3 var(--primary-family);
        }
        .nav-promo_action {
          margin-bottom: 1.5rem;
        }
      }
      &.wide .nav-promo_image {
        height: auto;
        aspect-ratio: 16 / 9;
        object-position: center;
      }
      &.wide .nav-promo_title {
        max-width: 27rem;
        font-size: 1.5rem;
        line-height: 1;
      }
      &.compact {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        grid-template-rows: 1fr auto auto;
        gap: 1.5rem;
        .nav-promo_image {
          height: 14.625rem;
        }
        .nav-promo_label {
          margin-top: 1rem;
          font: 400 0.875rem/1.3 var(--primary-family);
        }
        .nav-promo_title {
          font-size: 0.875rem;
          line-height: 1.4;
        }
        .nav-promo_action {
          margin-bottom: 1rem;
        }
      }
      &.mobile {
        grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
        gap: 0.5rem 0.75rem;
        .nav-promo_label {
          grid-column: 1 / -1;
          grid-row: 1;
        }
        .nav-promo_image {
          grid-column: 1;
          grid-row: 2 / 4;
          height: auto;
          aspect-ratio: 394 / 272;
        }
        .nav-promo_title {
          grid-column: 2;
          grid-row: 2;
          font-size: 0.875rem;
        }
        .nav-promo_action {
          grid-column: 2;
          grid-row: 3;
        }
        .nav-promo_label,
        .nav-promo_action {
          font-size: 0.75rem;
        }
      }
    }
  }
</style>

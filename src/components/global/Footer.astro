---
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import { SITE_NAME } from "@/consts.ts";
import {
  footerPages,
  footerIndustries,
  footerPartners,
  footerSocials,
} from "@/data/footer";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}
const { render = true } = Astro.props;
const columns = [footerPages, footerIndustries, footerPartners];
---

{
  render && (
    <footer class="footer_wrap">
      <div class="footer_inner">
        <div class="footer_rules layout_rules" aria-hidden="true">
          <>
            <span />
            <span />
            <span />
          </>
        </div>
        <div class="footer_main layout_columns position-relative align-items-stretch">
          <a class="footer_logo" href="/" aria-label={`${SITE_NAME} home`}>
            <img
              class="footer_brand"
              src="/footer/logo.svg"
              width="150"
              height="71"
              alt=""
            />
          </a>
          {columns.map((groups, index) => (
            <nav
              class:list={["footer_column", `footer_column-${index}`]}
              aria-label={
                ["Company and businesses", "Industries", "Resources"][index]
              }
            >
              {groups.map((group) => (
                <div class="footer_group flex-vertical-nowrap align-items-stretch justify-content-start">
                  <Heading
                    tag="h2"
                    variant="inherit"
                    class:list={["footer_label text-style-label", group.action && "action"]}
                  >
                    {group.action ? (
                      <Fragment>
                        {group.href ? (
                          <a class="footer_link flex-horizontal-nowrap" href={group.href}>
                            <span class="footer_link-text">{group.label}</span>
                            <img
                              class="footer_arrow"
                              src="/footer/chevron.svg"
                              width="10.508"
                              height="10.508"
                              alt=""
                            />
                          </a>
                        ) : (
                          <span class="footer_link flex-horizontal-nowrap" aria-disabled="true">
                            <span class="footer_link-text">{group.label}</span>
                            <img
                              class="footer_arrow"
                              src="/footer/chevron.svg"
                              width="10.508"
                              height="10.508"
                              alt=""
                            />
                          </span>
                        )}
                      </Fragment>
                    ) : (
                      group.label
                    )}
                  </Heading>
                  {group.items && (
                    <ul class="footer_links flex-vertical-nowrap align-items-stretch justify-content-start padding-0">
                      {group.items.map((item) => (
                        <li>
                          {item.href ? (
                            <a class="footer_link flex-horizontal-nowrap" href={item.href}>
                              <span class="footer_link-text">{item.label}</span>
                              <img
                                class="footer_arrow"
                                src="/footer/chevron.svg"
                                width="10.508"
                                height="10.508"
                                alt=""
                              />
                            </a>
                          ) : (
                            <span class="footer_link flex-horizontal-nowrap" aria-disabled="true">
                              <span class="footer_link-text">{item.label}</span>
                              <img
                                class="footer_arrow"
                                src="/footer/chevron.svg"
                                width="10.508"
                                height="10.508"
                                alt=""
                              />
                            </span>
                          )}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </nav>
          ))}
        </div>
        <div class="footer_bottom layout_columns position-relative">
          <div class="footer_inquiries">
            <Heading tag="h2" variant="inherit" class="footer_label text-style-label">
              For general inquiries
            </Heading>
            <address class="footer_address flex-vertical-nowrap align-items-stretch justify-content-start gap-1">
              <>
                <a
                  class="footer_link flex-horizontal-nowrap"
                  href="mailto:contact@thedecimalcapital.com"
                >
                  <span class="footer_link-text">contact@thedecimalcapital.com</span>
                  <img
                    class="footer_arrow"
                    src="/footer/chevron.svg"
                    width="10.508"
                    height="10.508"
                    alt=""
                  />
                </a>
                <a class="footer_link flex-horizontal-nowrap" href="tel:+919560011852">
                  <span class="footer_link-text">+91 9560011852</span>
                  <img
                    class="footer_arrow"
                    src="/footer/chevron.svg"
                    width="10.508"
                    height="10.508"
                    alt=""
                  />
                </a>
              </>
            </address>
          </div>
          <div class="footer_credits">
            <Paragraph class="footer_label text-style-label">
              © {new Date().getFullYear()} COPYRIGHT. ALL RIGHTS RESERVED.
            </Paragraph>
            <ul class="footer_socials flex-horizontal-nowrap padding-0" aria-label="Social media">
              {footerSocials.map((social) => (
                <li>
                  {social.href ? (
                    <a href={social.href} aria-label={social.label}>
                      <img
                        src={`/footer/${social.icon}.svg`}
                        width="24"
                        height="24"
                        alt=""
                      />
                    </a>
                  ) : (
                    <span aria-label={social.label} aria-disabled="true">
                      <img
                        src={`/footer/${social.icon}.svg`}
                        width="24"
                        height="24"
                        alt=""
                      />
                    </span>
                  )}
                </li>
              ))}
            </ul>
            <Paragraph class="footer_label text-style-label">
              <a class="footer_link flex-horizontal-nowrap" href="#">
                <span class="footer_link-text">Everything Design | Brand Design Partner</span>
              </a>
            </Paragraph>
          </div>
        </div>
      </div>
    </footer>
  )
}

<style is:global>
  @layer components {
    .footer_wrap {
      --_rule: var(--border-hairline) solid
        color-mix(in srgb, var(--dark-900) 20%, transparent);
      --_padding: var(--section-space-small);
      background: var(--light-300);
      color: var(--dark-900);
      padding: var(--_padding) var(--layout-gutter);
      border-block: var(--_rule);
      .footer_inner {
        position: relative;
        max-width: var(--layout-max-width);
        margin-inline: auto;
      }
      .footer_rules {
        inset-block: calc(-1 * var(--_padding));
      }
      .footer_logo {
        grid-column: 1;
        grid-row: 1;
        display: block;
        width: 9.375rem;
        max-width: 100%;
        align-self: start;
      }
      .footer_brand {
        display: block;
        width: 100%;
        height: auto;
      }
      .footer_column {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
        padding-inline: var(--space-3);
      }
      .footer_column-0 {
        grid-column: 2;
        grid-row: 1;
      }
      .footer_column-1 {
        grid-column: 3;
        grid-row: 1;
        margin-right: 35.365854%;
      }
      .footer_column-2 {
        grid-column: 3;
        grid-row: 1;
        margin-left: 64.634146%;
        border-left: var(--_rule);
      }
      .footer_group {
        gap: var(--space-4);
      }
      .footer_label {
        margin-block: 0;
        color: var(--neutral-500);
        text-wrap: initial;
      }
      .footer_label.action {
        color: var(--dark-900);
        font-weight: var(--primary-medium);
        line-height: normal;
      }
      .footer_links {
        gap: var(--space-3);
        list-style: none;
        font: var(--primary-light) 1rem/normal var(--heading-family);
      }
      .footer_link {
        gap: var(--space-1);
        max-width: 100%;
      }
      .footer_link > span {
        text-box: trim-both cap alphabetic;
        min-width: 0;
      }
      .footer_arrow {
        width: 0.65675rem;
        height: 0.65675rem;
        flex: none;
      }
      .footer_bottom {
        margin-top: var(--section-space-small);
      }
      .footer_inquiries {
        grid-column: 2;
      }
      .footer_inquiries,
      .footer_credits {
        padding-inline: var(--space-3);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-4);
        min-width: 0;
      }
      .footer_credits {
        grid-column: 3;
      }
      .footer_address {
        font: var(--primary-light) 1.125rem/normal var(--primary-family);
        overflow-wrap: anywhere;
      }
      .footer_socials {
        list-style: none;
        gap: var(--space-4);
      }
      .footer_socials img {
        width: 1.5rem;
        height: 1.5rem;
      }
      .footer_label:not(.action) {
        line-height: 1.4;
      }
      a {
        text-decoration: none;
        transition:
          color var(--hover-duration) var(--hover-ease),
          opacity var(--hover-duration) var(--hover-ease);
      }
      .footer_link-text,
      .footer_socials a {
        position: relative;
      }
      .footer_socials a {
        display: inline-flex;
        border: 0;
        text-decoration: none;
        &::after { content: none; }
      }
      .footer_link-text::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.25rem;
        height: 0.0625rem;
        background: var(--dark-900);
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform var(--motion-reveal-duration) var(--motion-roll-ease);
        pointer-events: none;
      }
      a.footer_link:focus-visible .footer_link-text::after {
        transform: scaleX(1);
      }
      @media (hover: hover) {
        a.footer_link:hover .footer_link-text::after {
          transform: scaleX(1);
        }
        a.footer_link:hover .footer_arrow {
          transform: translateX(0.35rem);
        }
      }
      a:focus-visible {
        outline: var(--focus-width) solid var(--brand-500);
        outline-offset: var(--focus-offset);
      }
      .footer_arrow {
        transition: transform var(--motion-reveal-duration) var(--motion-roll-ease);
      }
      .footer_socials img {
        transition: transform var(--hover-duration) var(--hover-ease);
      }
      a.footer_link:focus-visible .footer_arrow {
        transform: translateX(0.35rem);
      }
      @media (prefers-reduced-motion: reduce) {
        .footer_link-text::after,
        .footer_arrow {
          transition: none;
        }
      }
      .footer_socials a:is(:hover, :focus-visible) img {
        transform: translateY(-0.2rem);
      }
      .footer_logo:hover {
        opacity: 0.8;
      }
      @media (width >= 64rem) {
        .footer_logo {
          width: 6rem;
          margin-left: 1rem;
        }
        .footer_column {
          border-left: var(--border-hairline) solid
            color-mix(in srgb, var(--dark-900) 60%, transparent);
        }
        .footer_column-1 {
          margin-right: 28%;
          align-self: start;
        }
        .footer_column-2 {
          margin-left: 72%;
          gap: var(--space-7);
          padding-right: 0;
          align-self: stretch;
          margin-bottom: var(--space-5);
        }
        .footer_column-2 .footer_group {
          gap: var(--space-3);
        }
        .footer_column-2 .footer_group:last-child {
          gap: var(--space-4);
        }
        .footer_links {
          line-height: 1.1;
        }
        .footer_links .footer_link {
          display: flex;
          width: fit-content;
        }
        .footer_link > span {
          text-box: normal;
        }
        .footer_bottom {
          margin-top: 4rem;
        }
        .footer_inquiries,
        .footer_credits {
          border-left: var(--border-hairline) solid
            color-mix(in srgb, var(--dark-900) 60%, transparent);
        }
        .footer_inquiries {
          gap: var(--space-4);
        }
        .footer_address {
          font-size: 1rem;
          gap: var(--space-3);
        }
        .footer_credits {
          gap: var(--space-3);
        }
        .footer_socials {
          gap: 1.75rem;
        }
        .footer_socials img {
          width: 1.25rem;
          height: 1.25rem;
        }
      }
      @media (64rem <= width < 75rem) {
        .footer_column-1 { margin-right: 38%; }
        .footer_column-2 { margin-left: 62%; padding-left: 0.75rem; }
        .footer_label { font-size: 0.875rem; }
        .footer_address { font-size: 0.875rem; }
      }
      @media (width < 64rem) {
        .footer_main {
          grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
          row-gap: var(--space-8);
        }
        .footer_logo {
          grid-column: 1 / -1;
          grid-row: auto;
        }
        .footer_column {
          border-left: var(--_rule);
        }
        .footer_column-0 {
          grid-column: 1;
          grid-row: 2;
        }
        .footer_column-1 {
          grid-column: 2;
          grid-row: 2 / 4;
          margin: 0;
        }
        .footer_column-2 {
          grid-column: 1;
          grid-row: 3;
          margin: 0;
        }
        .footer_bottom {
          grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
          row-gap: var(--space-6);
          column-gap: 0;
        }
        .footer_inquiries {
          grid-column: 1;
          border-left: var(--_rule);
        }
        .footer_credits {
          grid-column: 2;
          border-left: var(--_rule);
        }
      }
      @media (width < 48rem) {
        --_padding: 3rem;
        padding-inline: var(--layout-gutter);
        .footer_main,
        .footer_bottom {
          grid-template-columns: minmax(0, 1fr);
        }
        .footer_main {
          row-gap: 2.5rem;
        }
        .footer_column,
        .footer_logo,
        .footer_inquiries,
        .footer_credits {
          grid-column: 1;
          grid-row: auto;
        }
        .footer_logo {
          width: 7.03125rem;
        }
        .footer_column {
          gap: var(--space-4);
          padding-inline: 0.75rem 0;
        }
        .footer_column-0,
        .footer_column-2 {
          display: grid;
          grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
          column-gap: 2rem;
          align-content: start;
        }
        .footer_column-2 {
          row-gap: 2rem;
          border-left: 0;
          padding-left: 0;
        }
        .footer_column-2 .footer_group:nth-child(odd) {
          border-left: var(--_rule);
          padding-left: 0.75rem;
        }
        .footer_column-2 .footer_group:last-child {
          grid-column: 1 / -1;
        }
        .footer_group {
          gap: var(--space-2);
        }
        .footer_label,
        .footer_links {
          font-size: 0.875rem;
        }
        .footer_label:not(.action) {
          line-height: 1.3;
        }
        .footer_links {
          gap: var(--space-2);
        }
        .footer_link {
          gap: var(--space-1);
        }
        .footer_column-1 .footer_links li:nth-child(4) .footer_link > span {
          max-width: 10.375rem;
        }
        .footer_bottom {
          margin-top: 2.5rem;
          padding-top: 2.5rem;
          border-top: var(--_rule);
          row-gap: 2rem;
        }
        .footer_inquiries,
        .footer_credits {
          padding-inline: 0.75rem 0;
          gap: var(--space-3);
        }
        .footer_inquiries .footer_label {
          font-size: 0.75rem;
        }
        .footer_address {
          font-family: var(--guide-family);
          font-size: 0.9375rem;
          gap: var(--space-1);
        }
        .footer_credits .footer_label {
          font-size: 0.6875rem;
          line-height: 1.3;
        }
        .footer_credits > .footer_label:last-child {
          display: none;
        }
        .footer_socials {
          gap: 1.35rem;
        }
        .footer_socials img {
          width: 1.35rem;
          height: 1.35rem;
        }
      }
    }
  }
</style>

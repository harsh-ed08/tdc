---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HTML element. */
  tag?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Eyebrow style. */
  variant?: "default" | "tag" | "section";
};

const {
  render = true,
  tag: Tag = "p",
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <div
      class:list={["eyebrow_wrap", variant === "section" ? "section-label" : variant !== "default" && variant, className]}
      {...rest}
    >
      {variant === "section" ? (
        <img class="eyebrow_oval" src="/purpose-icon.svg" alt="" width="8" height="12" />
      ) : variant !== "tag" && (
        <span class="eyebrow_marker" aria-hidden="true" />
      )}
      <Tag class:list={["eyebrow_text", variant === "section" ? "text-style-label" : "text-style-small"]}>
        <Fragment set:html={content} />
      </Tag>
    </div>
  )
}
